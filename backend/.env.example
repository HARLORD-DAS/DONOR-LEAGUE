# DONOR LEAGUE - Backend Environment Configuration

# Application
PROJECT_NAME="DONOR LEAGUE"
SECRET_KEY="donor-league-production-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: Local SQLite with async support
DATABASE_URL="sqlite+aiosqlite:///./donor_league.db"
# Production PostGIS / PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/donor_league"

# Production OpenStreetMap Services
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="DonorLeagueApp/1.0 (contact@donorleague.org)"
OSRM_BASE_URL="https://router.project-osrm.org"
OVERPASS_BASE_URL="https://overpass-api.de/api/interpreter"

# Meta WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="donor_league_verify_webhook_token"
WHATSAPP_SIMULATION_MODE=true

# SMS Gateway (MSG91)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="DNRLEAGUE"
SMS_SIMULATION_MODE=true

# Frontend base URL for notification links
APP_BASE_URL="http://localhost:3000"
