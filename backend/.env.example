# Copy these into your backend hosting provider's environment settings.
PROJECT_NAME="DONOR LEAGUE"
SECRET_KEY="replace-with-a-long-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Use a persistent PostgreSQL database in production.
DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE"

NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="DonorLeagueApp/1.0 (your-contact-email)"
OSRM_BASE_URL="https://router.project-osrm.org"
OVERPASS_BASE_URL="https://overpass-api.de/api/interpreter"

WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_SIMULATION_MODE=true

MSG91_AUTH_KEY=""
MSG91_SENDER_ID="DNRLEAGUE"
SMS_SIMULATION_MODE=true

APP_BASE_URL="https://your-vercel-domain.vercel.app"
FRONTEND_ORIGIN="https://your-vercel-domain.vercel.app"
SEED_DEMO_DATA=false
